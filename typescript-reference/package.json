{
  "name": "pokemon-rogue-typescript-reference",
  "private": true,
  "version": "1.10.4",
  "type": "module",
  "description": "TypeScript reference implementation for parity testing",
  "scripts": {
    "build": "vite build",
    "build:reference": "vite build --config vite.config.ts",
    "test": "vitest run --no-isolate",
    "test:reference": "vitest run --no-isolate --config vitest.config.ts",
    "start:game": "vite --mode development",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@types/crypto-js": "^4.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/expect": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.2.7",
    "compare-versions": "^6.1.1",
    "crypto-js": "^4.2.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-korean-postposition-processor": "^1.0.0",
    "json-stable-stringify": "^1.3.0",
    "jszip": "^3.10.1",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.16"
  },
  "engines": {
    "node": ">=22.0.0"
  }
