{
  "testScenario": {
    "id": "state-sync-001",
    "name": "Cross-Process State Synchronization Validation",
    "type": "orchestration",
    "description": "Tests GameState consistency across multiple process boundaries during complex workflows",
    "processes": [
      "coordinator-process",
      "state-validator",
      "battle-engine",
      "pokemon-species-db",
      "inventory-manager",
      "progression-tracker"
    ]
  },
  "initialGameState": {
    "version": "1.0.0",
    "playerId": "test-player-sync-001",
    "battleId": "sync-battle-001",
    "party": [
      {
        "id": "pokemon-001",
        "speciesId": 150,
        "name": "Mewtwo",
        "level": 70,
        "experience": 343000,
        "stats": {
          "hp": 310,
          "attack": 200,
          "defense": 180,
          "specialAttack": 285,
          "specialDefense": 180,
          "speed": 235
        },
        "currentHp": 310,
        "nature": "Modest",
        "moves": [94, 129, 105, 411]
      }
    ],
    "inventory": {
      "items": [
        {
          "itemId": 20,
          "name": "Full Restore",
          "quantity": 3
        }
      ],
      "pokeballs": []
    },
    "progression": {
      "level": 50,
      "experience": 1250000,
      "badges": 8,
      "pokedexSeen": 150,
      "pokedexCaught": 85
    },
    "currentBattle": {
      "battleType": "trainer",
      "turn": 1,
      "phase": "command",
      "playerPokemon": {
        "id": "pokemon-001",
        "currentHp": 310
      },
      "enemyPokemon": {
        "speciesId": 149,
        "level": 75,
        "currentHp": 295,
        "maxHp": 295
      }
    }
  },
  "messageFlow": [
    {
      "step": 1,
      "source": "test-client",
      "target": "coordinator-process",
      "action": "CoordinateWorkflow",
      "data": {
        "workflowType": "state_synchronization_test",
        "operations": ["validate_initial_state", "process_item_usage", "update_battle_state", "validate_final_state"]
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true
      },
      "timeout": 15000,
      "description": "Initiate multi-process state synchronization test"
    },
    {
      "step": 2,
      "source": "coordinator-process",
      "target": "state-validator",
      "action": "ValidateGameState",
      "data": {
        "gameState": "{{INITIAL_GAMESTATE}}",
        "context": "initial_validation",
        "validationLevel": "comprehensive"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "valid": true,
          "checksum": "initial_state_checksum",
          "validationErrors": [],
          "warnings": []
        }
      },
      "timeout": 3000,
      "description": "Validate initial state consistency",
      "stateCapture": "before_operations"
    },
    {
      "step": 3,
      "source": "coordinator-process",
      "target": "inventory-manager",
      "action": "ConsumeItem",
      "data": {
        "itemId": 20,
        "quantity": 1,
        "targetPokemon": "pokemon-001",
        "context": "battle_item_usage"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "itemConsumed": true,
          "remainingQuantity": 2,
          "healingApplied": true,
          "newHp": 310
        }
      },
      "timeout": 2000,
      "description": "Use Full Restore item on Pokemon",
      "stateCapture": "after_item_usage"
    },
    {
      "step": 4,
      "source": "coordinator-process",
      "target": "state-validator",
      "action": "ValidateGameState",
      "data": {
        "gameState": "{{UPDATED_GAMESTATE}}",
        "context": "post_item_validation",
        "validationLevel": "comprehensive",
        "previousChecksum": "initial_state_checksum"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "valid": true,
          "checksum": "post_item_checksum",
          "validationErrors": [],
          "warnings": [],
          "stateChanged": true,
          "changedFields": ["inventory.items[0].quantity"]
        }
      },
      "timeout": 3000,
      "description": "Validate state after item usage",
      "stateCapture": "post_item_validation"
    },
    {
      "step": 5,
      "source": "coordinator-process",
      "target": "battle-engine",
      "action": "ProcessBattle",
      "data": {
        "battleData": {
          "attacker": {
            "id": "pokemon-001",
            "speciesId": 150,
            "level": 70,
            "currentHp": 310,
            "stats": {
              "hp": 310,
              "attack": 200,
              "defense": 180,
              "specialAttack": 285,
              "specialDefense": 180,
              "speed": 235
            }
          },
          "defender": {
            "speciesId": 149,
            "level": 75,
            "currentHp": 295,
            "maxHp": 295
          },
          "move": {
            "moveId": 94,
            "name": "Psychic",
            "type": "Psychic",
            "category": "Special",
            "power": 90
          },
          "battleSeed": "sync-test-seed-001"
        }
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "battleResult": {
            "damage": 180,
            "critical": false,
            "effectiveness": 1.0,
            "enemyNewHp": 115,
            "turnComplete": true
          }
        }
      },
      "timeout": 4000,
      "description": "Process battle turn with state updates",
      "stateCapture": "after_battle_turn"
    },
    {
      "step": 6,
      "source": "coordinator-process",
      "target": "progression-tracker",
      "action": "UpdateExperience",
      "data": {
        "pokemonId": "pokemon-001",
        "experienceGained": 2500,
        "context": "battle_victory",
        "enemyLevel": 75
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "experienceUpdated": true,
          "newExperience": 345500,
          "levelUp": false,
          "progressionUpdated": true
        }
      },
      "timeout": 2000,
      "description": "Update Pokemon experience after battle",
      "stateCapture": "after_experience_update"
    },
    {
      "step": 7,
      "source": "coordinator-process",
      "target": "state-validator",
      "action": "ValidateStateTransition",
      "data": {
        "beforeState": "{{BEFORE_OPERATIONS_STATE}}",
        "afterState": "{{FINAL_GAMESTATE}}",
        "expectedChanges": [
          {
            "path": "inventory.items[0].quantity",
            "type": "value_change",
            "expectedValue": 2
          },
          {
            "path": "party[0].experience",
            "type": "value_change",
            "expectedValue": 345500
          },
          {
            "path": "currentBattle.enemyPokemon.currentHp",
            "type": "value_change",
            "expectedValue": 115
          }
        ]
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "transitionValid": true,
          "expectedChangesFound": 3,
          "unexpectedChanges": 0,
          "validationErrors": [],
          "warnings": []
        }
      },
      "timeout": 4000,
      "description": "Validate complete state transition consistency",
      "stateCapture": "final_validation"
    }
  ],
  "stateCaptures": {
    "before_operations": {
      "description": "Initial state before any operations",
      "key_fields": ["party[0].experience", "inventory.items[0].quantity", "currentBattle.enemyPokemon.currentHp"]
    },
    "after_item_usage": {
      "description": "State after consuming Full Restore",
      "expected_changes": ["inventory.items[0].quantity"]
    },
    "post_item_validation": {
      "description": "State validation after item usage",
      "validation_level": "comprehensive"
    },
    "after_battle_turn": {
      "description": "State after battle turn processing",
      "expected_changes": ["currentBattle.enemyPokemon.currentHp"]
    },
    "after_experience_update": {
      "description": "State after experience gain",
      "expected_changes": ["party[0].experience"]
    },
    "final_validation": {
      "description": "Final state validation",
      "validation_level": "comprehensive"
    }
  },
  "consistencyChecks": [
    {
      "name": "inventory_consistency",
      "description": "Item quantities must be consistent across processes",
      "field": "inventory.items",
      "validation": "exact_match"
    },
    {
      "name": "pokemon_experience_consistency",
      "description": "Pokemon experience must be consistent",
      "field": "party[0].experience",
      "validation": "exact_match"
    },
    {
      "name": "battle_state_consistency",
      "description": "Battle state must be consistent",
      "field": "currentBattle",
      "validation": "schema_compliance"
    },
    {
      "name": "checksum_integrity",
      "description": "State checksums must be valid at each step",
      "validation": "checksum_verification"
    }
  ],
  "assertions": [
    {
      "type": "state_consistency",
      "condition": "initial_state_valid",
      "expected": true,
      "description": "Initial GameState should be valid and consistent"
    },
    {
      "type": "state_consistency",
      "condition": "item_usage_state_consistent",
      "expected": true,
      "description": "State should remain consistent after item usage"
    },
    {
      "type": "state_consistency",
      "condition": "battle_state_consistent",
      "expected": true,
      "description": "Battle state should remain consistent during turn processing"
    },
    {
      "type": "state_consistency",
      "condition": "experience_update_consistent",
      "expected": true,
      "description": "Experience updates should maintain state consistency"
    },
    {
      "type": "coordination",
      "condition": "all_processes_synchronized",
      "expected": true,
      "description": "All processes should have consistent view of GameState"
    },
    {
      "type": "data_integrity",
      "condition": "no_data_corruption",
      "expected": true,
      "description": "No data should be corrupted during cross-process operations"
    },
    {
      "type": "state_consistency",
      "condition": "state_transition_valid",
      "expected": true,
      "description": "Complete state transition should be valid and trackable"
    },
    {
      "type": "performance",
      "condition": "total_execution_time",
      "expected": "<15000ms",
      "tolerance": "10%",
      "description": "State synchronization should complete within 15 seconds"
    }
  ],
  "tolerances": {
    "timing_tolerance": 100,
    "numeric_tolerance": 0,
    "checksum_validation": "strict"
  },
  "metadata": {
    "author": "Integration Test Framework",
    "created": "2025-09-22",
    "tags": ["state-sync", "coordination", "multi-process", "consistency"],
    "priority": "critical",
    "complexity": "advanced",
    "expectedDuration": 15000,
    "retryCount": 1,
    "testCategory": "state_management"
  }
}
