  "assertions": [
    {
      "type": "state_consistency",
      "condition": "pokemon_captured_successfully",
      "expected": true,
      "description": "Wild Pokemon should be successfully captured and added to party"
    },
    {
      "type": "data_integrity",
      "condition": "pokeball_consumed",
      "expected": true,
      "description": "Pokeball should be removed from inventory after use"
    },
    {
      "type": "coordination",
      "condition": "capture_workflow_completed",
      "expected": true,
      "description": "Complete capture workflow should succeed without errors"
    },
    {
      "type": "performance",
      "condition": "total_execution_time",
      "expected": "<10000ms",
      "tolerance": "10%",
      "description": "Capture workflow should complete within 10 seconds"
    },
    {
      "type": "data_integrity",
      "condition": "captured_pokemon_stats_valid",
      "expected": true,
      "description": "Captured Pokemon should have valid stats and IVs"
    },
    {
      "type": "state_consistency",
      "condition": "party_size_increased",
      "expected": true,
      "description": "Party size should increase from 1 to 2"
    },
    {
      "type": "data_integrity",
      "condition": "capture_info_preserved",
      "expected": true,
      "description": "Capture information should be stored with Pokemon"
    },
    {
      "type": "state_consistency",
      "condition": "battle_ended",
      "expected": true,
      "description": "Battle should end after successful capture"
    },
    {
      "type": "data_integrity",
      "condition": "pokedex_updated",
      "expected": true,
      "description": "Pokedex caught count should increase"
    }
  ],
  "captureCalculation": {
    "formula": "Modified Gen III capture formula",
    "factors": [
      {
        "name": "HP Factor",
        "calculation": "(3 * maxHp - 2 * currentHp) / (3 * maxHp)",
        "value": 0.5
      },
      {
        "name": "Status Factor",
        "condition": "sleep",
        "multiplier": 2.0
      },
      {
        "name": "Ball Factor",
        "item": "Poke Ball",
        "multiplier": 1.0
      },
      {
        "name": "Species Factor",
        "baseCaptureRate": 255,
        "description": "Pidgey has high base capture rate"
      }
    ],
    "expectedRate": 127.5,
    "successThreshold": 65535
  },
  "stateTransitions": [
