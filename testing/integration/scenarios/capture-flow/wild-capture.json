{
  "testScenario": {
    "id": "wild-capture-001",
    "name": "Wild Pokemon Capture Complete Workflow",
    "type": "end-to-end",
    "description": "Tests complete capture workflow from encounter through party integration",
    "processes": [
      "coordinator-process",
      "battle-engine",
      "capture-engine",
      "pokemon-species-db",
      "items-database",
      "rng-coordinator",
      "state-validator",
      "inventory-manager"
    ]
  },
  "initialGameState": {
    "version": "1.0.0",
    "playerId": "test-player-capture-001",
    "battleId": "capture-battle-001",
    "party": [
      {
        "id": "pokemon-001",
        "speciesId": 25,
