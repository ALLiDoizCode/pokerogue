    "progression": {
      "pokedexSeen": 25,
      "pokedexCaught": 12
    }
  },
  "messageFlow": [
    {
      "step": 1,
      "source": "test-client",
      "target": "coordinator-process",
      "action": "CoordinateWorkflow",
      "data": {
        "workflowType": "pokemon_capture",
        "battleId": "capture-battle-001",
        "captureData": {
          "pokeball": {
            "itemId": 4,
            "name": "Poke Ball",
            "captureRate": 1.0
          },
          "targetPokemon": {
            "speciesId": 16,
            "level": 18,
            "currentHp": 25,
            "maxHp": 55,
            "statusCondition": "sleep"
          },
          "battleSeed": "capture-seed-12345"
        }
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true
      },
      "timeout": 10000,
      "description": "Initiate Pokemon capture workflow"
    },
    {
      "step": 2,
      "source": "coordinator-process",
      "target": "items-database",
      "action": "QueryItem",
      "data": {
        "itemId": 4
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "itemId": 4,
          "name": "Poke Ball",
          "category": "pokeball",
          "captureRate": 1.0,
          "effects": ["basic_capture"]
        }
      },
      "timeout": 2000,
      "description": "Get pokeball information for capture calculation"
    },
    {
      "step": 3,
      "source": "coordinator-process",
      "target": "pokemon-species-db",
      "action": "QuerySpecies",
      "data": {
        "speciesId": 16
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "speciesId": 16,
          "name": "Pidgey",
          "type1": "Normal",
          "type2": "Flying",
          "baseCaptureRate": 255,
          "baseStats": {
            "hp": 40,
            "attack": 45,
            "defense": 40,
            "specialAttack": 35,
            "specialDefense": 35,
            "speed": 56
          }
        }
      },
      "timeout": 2000,
      "description": "Get target Pokemon species data for capture calculation"
    },
    {
      "step": 4,
      "source": "coordinator-process",
      "target": "capture-engine",
      "action": "CalculateCapture",
      "data": {
        "targetPokemon": {
          "speciesId": 16,
          "level": 18,
          "currentHp": 25,
          "maxHp": 55,
          "baseCaptureRate": 255,
          "statusCondition": "sleep"
        },
        "pokeball": {
          "itemId": 4,
          "captureRate": 1.0
        },
        "battleSeed": "capture-seed-12345"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "captureRate": 127.5,
          "shakeCount": 4,
          "captureSuccessful": true,
          "criticalCapture": false,
          "modifiers": {
            "hpModifier": 0.5,
            "statusModifier": 2.0,
            "ballModifier": 1.0
          }
        }
      },
      "timeout": 3000,
      "description": "Calculate capture probability and determine success"
    },
    {
      "step": 5,
      "source": "coordinator-process",
      "target": "inventory-manager",
      "action": "ConsumeItem",
      "data": {
        "itemId": 4,
        "quantity": 1,
        "context": "pokeball_used"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "itemConsumed": true,
          "remainingQuantity": 4,
          "inventoryUpdated": true
        }
      },
      "timeout": 1000,
      "description": "Remove used pokeball from inventory"
    },
    {
      "step": 6,
      "source": "coordinator-process",
      "target": "battle-engine",
      "action": "GenerateCapturedPokemon",
      "data": {
        "wildPokemon": {
          "speciesId": 16,
          "level": 18,
          "currentHp": 25,
          "maxHp": 55,
          "statusCondition": "sleep",
          "nature": "Hardy"
        },
        "captureContext": {
          "captureLocation": "Route 1",
          "captureDate": "2025-09-22",
          "pokeball": "Poke Ball"
        },
        "battleSeed": "capture-seed-12345"
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "capturedPokemon": {
            "id": "pokemon-002",
            "speciesId": 16,
            "name": "Pidgey",
            "level": 18,
            "experience": 5832,
            "nature": "Hardy",
            "ivs": {
              "hp": 12,
              "attack": 8,
              "defense": 15,
              "specialAttack": 11,
              "specialDefense": 7,
              "speed": 13
            },
            "stats": {
              "hp": 55,
              "attack": 38,
              "defense": 40,
              "specialAttack": 29,
              "specialDefense": 29,
              "speed": 45
            },
            "currentHp": 55,
            "moves": [16, 28, 17, 98],
            "captureInfo": {
              "location": "Route 1",
              "date": "2025-09-22",
              "pokeball": "Poke Ball"
            }
          }
        }
      },
      "timeout": 3000,
      "description": "Generate captured Pokemon with stats and moves"
    },
    {
      "step": 7,
      "source": "coordinator-process",
      "target": "state-validator",
      "action": "ValidateParty",
      "data": {
        "party": [
          {
            "id": "pokemon-001",
            "speciesId": 25,
            "name": "Pikachu",
            "level": 22,
            "currentHp": 65
          },
          {
            "id": "pokemon-002",
            "speciesId": 16,
            "name": "Pidgey",
            "level": 18,
            "currentHp": 55
          }
        ],
        "partyLimit": 6
      },
      "expectedResponse": {
        "Action": "Success",
        "Success": true,
        "Data": {
          "valid": true,
          "partySize": 2,
          "validationErrors": [],
          "warnings": []
        }
      },
      "timeout": 2000,
      "description": "Validate party state after adding captured Pokemon"
    }
  ],
