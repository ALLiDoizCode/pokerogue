          "quantity": 5
        },
        {
          "itemId": 3,
          "name": "Great Ball",
          "quantity": 2
        }
      ],
      "items": []
    },
    "currentBattle": {
      "battleType": "wild",
      "turn": 3,
      "phase": "capture_attempt",
      "playerPokemon": {
        "id": "pokemon-001",
        "currentHp": 65
      },
      "wildPokemon": {
        "speciesId": 16,
        "level": 18,
        "currentHp": 25,
        "maxHp": 55,
        "stats": {
          "hp": 55,
          "attack": 38,
          "defense": 34,
          "specialAttack": 29,
          "specialDefense": 29,
          "speed": 45
        },
        "statusCondition": "sleep",
        "nature": "Hardy"
      },
