{
  "name": "pokemon-rogue-battle",
  "private": true,
  "version": "1.10.4",
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:dev": "vite --mode development",
    "build": "vite build",
    "build:beta": "vite build --mode beta",
    "preview": "vite preview",
    "test": "vitest run --no-isolate",
    "test:cov": "vitest run --coverage --no-isolate",
    "test:watch": "vitest watch --coverage --no-isolate",
    "test:silent": "vitest run --silent='passed-only' --no-isolate",
    "test:create": "node scripts/create-test/create-test.js",
    "test:aolite": "lua scripts/run-aolite-tests.lua",
    "test:aos-local": "node scripts/run-aos-local-tests.js",
    "test:parity": "node scripts/run-parity-tests.js",
    "test:statistical": "node scripts/run-statistical-tests.js",
    "test:performance": "node scripts/run-performance-tests.js",
    "test:all": "npm run test:aolite && npm run test:aos-local && npm run test:parity && npm run test:statistical && npm run test:performance",
    "validate:size": "lua tools/size-validator.lua",
    "lint:ao-sandbox": "lua tools/ao-sandbox-validator.lua",
    "tdd:run": "scripts/tdd/test-runner-wrapper.sh",
    "tdd:watch": "scripts/tdd/test-runner-wrapper.sh --watch",
    "tdd:coverage": "scripts/tdd/test-runner-wrapper.sh --coverage --report",
    "tdd:dashboard": "scripts/tdd/test-runner-wrapper.sh --coverage --report --dashboard",
    "tdd:generate-tests": "lua scripts/generators/test-skeleton-generator.lua generate",
    "tdd:generate-docs": "lua scripts/generators/test-doc-generator.lua generate",
    "tdd:validate": "scripts/hooks/tdd-pre-commit.sh",
    "tdd:create-issues": "node tools/issue-linker/github-integration.js create",
    "tdd:close-resolved-issues": "node tools/issue-linker/github-integration.js close",
    "tdd:refresh-dashboard": "node scripts/coverage/coverage-reporter.js && open tools/dashboard/index.html",
    "coverage:collect": "lua scripts/coverage/lua-coverage-collector.lua",
    "coverage:report": "node scripts/coverage/coverage-reporter.js",
    "scrape-trainers": "node scripts/scrape-trainer-names/main.js",
    "typecheck": "tsc --noEmit",
    "biome": "biome check --write --changed --no-errors-on-unmatched --diagnostic-level=error",
    "biome-ci": "biome ci --diagnostic-level=error --reporter=github --no-errors-on-unmatched",
    "docs": "typedoc",
    "depcruise": "depcruise src test",
    "postinstall": "lefthook install; git submodule update --init --recursive",
    "update-version:patch": "pnpm version patch --force --no-git-tag-version",
    "update-version:minor": "pnpm version minor --force --no-git-tag-version",
    "update-locales:remote": "git submodule update --progress --init --recursive --force --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@octokit/rest": "^22.0.0",
    "@permaweb/loco": "^0.0.20",
    "@types/crypto-js": "^4.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/expect": "^3.2.4",
    "chalk": "^5.4.1",
    "dependency-cruiser": "^16.10.4",
    "inquirer": "^12.8.2",
    "jsdom": "^26.1.0",
    "lefthook": "^1.12.2",
    "msw": "^2.10.4",
    "phaser3spectorjs": "^0.0.8",
    "typedoc": "^0.28.8",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-canvas-mock": "^0.3.3"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.2.7",
    "@permaweb/aoconnect": "^0.0.90",
    "compare-versions": "^6.1.1",
    "crypto-js": "^4.2.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-korean-postposition-processor": "^1.0.0",
    "json-stable-stringify": "^1.3.0",
    "jszip": "^3.10.1",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.16"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
